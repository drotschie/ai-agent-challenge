# ==============================================================================
# South African Gardener's Guide & Planting Verification Agent Environment Configuration
# ==============================================================================

# LLM Providers (Groq primary, Gemini fallback - free tiers available)
# Obtain free Groq key: https://console.groq.com
# Obtain free Gemini key: https://aistudio.google.com
# If both keys are left unset or set to your_*, the backend runs in deterministic fallback mode.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3-flash-preview

# Storage & Cache Directories
CHROMA_DB_DIR=data/chroma_db
FASTEMBED_CACHE_PATH=.cache/fastembed

# Optional Google OAuth Integration (Part 2 Live Calendar & Gmail)
# When left empty, Part 2 runs in 1-Click Reviewer Demo Mode using pre-seeded fixtures.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GMAIL_USER_EMAIL=
